<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="DevSetup" Width="1320" Height="860" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0A0B0F" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextRenderingMode="ClearType">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <sys:Double x:Key="CardWidth">300</sys:Double>

    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#A06BFF" Offset="0"/>
      <GradientStop Color="#6366F1" Offset="0.5"/>
      <GradientStop Color="#3B9CFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TextGrad" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#C4B5FD" Offset="0"/>
      <GradientStop Color="#93C5FD" Offset="0.6"/>
      <GradientStop Color="#67E8F9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gloss" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#40FFFFFF" Offset="0"/>
      <GradientStop Color="#00FFFFFF" Offset="0.7"/>
    </LinearGradientBrush>

    <!-- ================= Logo (46x46, use Viewbox for other sizes) ================= -->
    <DataTemplate x:Key="LogoTpl">
      <Grid Width="46" Height="46">
        <Border x:Name="tile" CornerRadius="12" Background="{Binding Color}">
          <Grid>
            <Border CornerRadius="12" Background="{StaticResource Gloss}"/>
            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="15" FontFamily="{StaticResource Display}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Border x:Name="iconTile" CornerRadius="12" Background="{Binding IconBg}" BorderBrush="#272D39" BorderThickness="1" Visibility="Collapsed">
          <Image Source="{Binding IconPath}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasIcon}" Value="True">
          <Setter TargetName="iconTile" Property="Visibility" Value="Visible"/>
          <Setter TargetName="tile" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Scrollbar ================= -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="t" CornerRadius="3" Background="#232833" Margin="3,2"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="t" Property="Background" Value="#3A4252"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="#1D212B" BorderBrush="#2E3443" BorderThickness="1" CornerRadius="7" Padding="10,6">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Buttons ================= -->
    <Style x:Key="ChromeBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Foreground" Value="#8B93A7"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Tag" Value="#1C2029"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="glow" CornerRadius="12" Background="{StaticResource AccentGrad}" Opacity="0.35" Margin="8,10,8,-4">
                <Border.Effect><BlurEffect Radius="22"/></Border.Effect>
              </Border>
              <Border x:Name="b" CornerRadius="12" Background="{StaticResource AccentGrad}"/>
              <Border CornerRadius="12" BorderThickness="1" BorderBrush="#33FFFFFF"/>
              <Border x:Name="hl" CornerRadius="12" Background="White" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="hl" Property="Opacity" Value="0.08"/>
                <Setter TargetName="glow" Property="Opacity" Value="0.7"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="hl" Property="Opacity" Value="0.16"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.22"/>
                <Setter TargetName="glow" Property="Opacity" Value="0"/>
                <Setter Property="Foreground" Value="#7E8296"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#D5DAE3"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="12" Background="#161A22" BorderBrush="#272D39" BorderThickness="1">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1E2330"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#3A4252"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TextBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#8B93A7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#161A22"/>
                <Setter Property="Foreground" Value="#F2F4F8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Search ================= -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F2F4F8"/>
      <Setter Property="CaretBrush" Value="#C4B5FD"/>
      <Setter Property="SelectionBrush" Value="#8B7BFF"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="ring" CornerRadius="13" Margin="-3" BorderBrush="#408B7BFF" BorderThickness="3" Opacity="0"/>
              <Border x:Name="b" CornerRadius="12" Background="#12151B" BorderBrush="#232833" BorderThickness="1">
                <Grid Margin="15,0,10,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="ic" Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="#5A6274" VerticalAlignment="Center" Margin="0,0,11,0"/>
                  <TextBlock x:Name="ph" Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#555D70" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                  <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
                  <Border Grid.Column="2" CornerRadius="6" Background="#1A1E27" BorderBrush="#262B36" BorderThickness="1" Padding="7,2,7,3" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl F" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B7385"/>
                  </Border>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#323949"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#8B7BFF"/>
                <Setter TargetName="ring" Property="Opacity" Value="1"/>
                <Setter TargetName="ic" Property="Foreground" Value="#C4B5FD"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Segmented filter ================= -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#8B93A7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="mode"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="8" Padding="14,7" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#E6E8EE"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#242938"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Sidebar nav ================= -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="0,1">
              <Border x:Name="b" Background="Transparent" CornerRadius="9" Padding="12,9">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="ic" Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#6B7385" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock x:Name="tx" Grid.Column="1" Text="{Binding Name}" Foreground="#A3AABA" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <Border x:Name="pill" Grid.Column="2" CornerRadius="6" Background="Transparent" Padding="6,1,6,2">
                    <TextBlock x:Name="ct" Text="{Binding Count}" Foreground="#4A5163" FontSize="11.5" FontWeight="SemiBold"/>
                  </Border>
                </Grid>
              </Border>
              <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,10,0,10" Background="{StaticResource AccentGrad}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#14171E"/>
                <Setter TargetName="tx" Property="Foreground" Value="#E6E8EE"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1A1830"/>
                <Setter TargetName="ic" Property="Foreground" Value="#B4A6FF"/>
                <Setter TargetName="tx" Property="Foreground" Value="White"/>
                <Setter TargetName="pill" Property="Background" Value="#2A2550"/>
                <Setter TargetName="ct" Property="Foreground" Value="#C4B5FD"/>
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PresetBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Padding="10,8" Margin="0,1" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{Binding Color}" Margin="0,0,12,0">
                  <Grid>
                    <Border CornerRadius="8" Background="{StaticResource Gloss}"/>
                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="n" Text="{Binding Name}" Foreground="#C9CED9" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Summary}" Foreground="#555D70" FontSize="11" Margin="0,1,0,0"/>
                </StackPanel>
                <Border x:Name="plus" Grid.Column="2" Width="24" Height="24" CornerRadius="7" Background="#242938" Opacity="0">
                  <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#14171E"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#1F242D"/>
                <Setter TargetName="n" Property="Foreground" Value="White"/>
                <Setter TargetName="plus" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Tool card ================= -->
    <Style x:Key="SiteBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#6B7385"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="26" Height="24" CornerRadius="7" Background="Transparent">
              <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#262B38"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolCard" TargetType="ToggleButton">
      <Setter Property="Width" Value="{DynamicResource CardWidth}"/>
      <Setter Property="Height" Value="122"/>
      <Setter Property="Margin" Value="0,0,14,14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid x:Name="root">
              <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
              <Border x:Name="selBorder" CornerRadius="15" Background="{StaticResource AccentGrad}" Opacity="0"/>
              <Border x:Name="card" CornerRadius="14" Margin="1.5" Background="#111419" BorderBrush="#1C2028" BorderThickness="1">
                <Grid Margin="15,14,12,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LogoTpl}" VerticalAlignment="Top"/>

                  <StackPanel Grid.Column="1" Margin="13,1,8,0">
                    <TextBlock Text="{Binding Name}" Foreground="#F2F4F8" FontSize="14.5" FontWeight="SemiBold" FontFamily="{StaticResource Display}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" Foreground="#7F879B" FontSize="12.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18" Margin="0,3,0,0"/>
                  </StackPanel>

                  <Grid x:Name="chkGrid" Grid.Column="2" Width="22" Height="22" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                    <Ellipse x:Name="chk" Stroke="#323848" StrokeThickness="1.5" Fill="Transparent"/>
                    <Ellipse x:Name="chkFill" Fill="{StaticResource AccentGrad}" Opacity="0"/>
                    <TextBlock x:Name="chkMark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                  </Grid>

                  <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="59,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border x:Name="inst" CornerRadius="6" Background="#0F2E22" BorderBrush="#164A35" BorderThickness="1" Padding="7,1,8,2" Visibility="Collapsed" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="6" Height="6" Fill="#3DD68C" VerticalAlignment="Center" Margin="0,1,6,0"/>
                          <TextBlock Text="Instalado" Foreground="#4ADE9B" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                      </Border>
                      <TextBlock x:Name="idText" Text="{Binding Id}" Foreground="#3F4555" FontSize="11" VerticalAlignment="Center" FontFamily="{StaticResource Mono}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                    </StackPanel>
                    <Button x:Name="siteBtn" Style="{StaticResource SiteBtn}" Tag="site" HorizontalAlignment="Right" ToolTip="Abrir site oficial" Opacity="0"/>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="card" Property="Background" Value="#151921"/>
                <Setter TargetName="card" Property="BorderBrush" Value="#2C3240"/>
                <Setter TargetName="chk" Property="Stroke" Value="#5A6274"/>
                <Setter TargetName="siteBtn" Property="Opacity" Value="1"/>
                <Setter TargetName="idText" Property="Foreground" Value="#5A6274"/>
                <Setter TargetName="root" Property="Effect">
                  <Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/></Setter.Value>
                </Setter>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="selBorder" Property="Opacity" Value="1"/>
                <Setter TargetName="card" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="card" Property="Background" Value="#16152A"/>
                <Setter TargetName="chk" Property="Stroke" Value="Transparent"/>
                <Setter TargetName="chkFill" Property="Opacity" Value="1"/>
                <Setter TargetName="chkMark" Property="Opacity" Value="1"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="chkGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.4" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="chkGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.4" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
              <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                <Setter TargetName="inst" Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Progress bar ================= -->
    <Style x:Key="SlimBar" TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource AccentGrad}"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4" Background="#1E222C"/>
              <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="pulse">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="pulse"/>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Install queue row ================= -->
    <DataTemplate x:Key="QueueItem">
      <Border x:Name="row" Padding="12,10" CornerRadius="11" Background="#14171E" BorderBrush="#1C2028" BorderThickness="1" Margin="0,0,0,7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Viewbox Width="34" Height="34">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LogoTpl}"/>
          </Viewbox>
          <StackPanel Grid.Column="1" Margin="13,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" Foreground="#F2F4F8" FontSize="13.5" FontWeight="SemiBold"/>
            <TextBlock x:Name="st" Text="{Binding Status}" Foreground="#6B7385" FontSize="12" Margin="0,2,0,0"/>
            <ProgressBar x:Name="pb" Height="4" Margin="0,7,0,0" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Visibility="Collapsed" Style="{StaticResource SlimBar}"/>
          </StackPanel>
          <Border x:Name="badge" Grid.Column="2" Width="28" Height="28" CornerRadius="14" Background="#1A1E27" VerticalAlignment="Center">
            <TextBlock x:Name="ic" Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#4A5163" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
            </TextBlock>
          </Border>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Running">
          <Setter TargetName="row" Property="BorderBrush" Value="#3B3470"/>
          <Setter TargetName="row" Property="Background" Value="#16152A"/>
          <Setter TargetName="ic" Property="Text" Value="&#xE895;"/>
          <Setter TargetName="ic" Property="Foreground" Value="#C4B5FD"/>
          <Setter TargetName="badge" Property="Background" Value="#2A2550"/>
          <Setter TargetName="st" Property="Foreground" Value="#B4A6FF"/>
          <Setter TargetName="pb" Property="Visibility" Value="Visible"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="spin">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="ic" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="spin"/>
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Done">
          <Setter TargetName="ic" Property="Text" Value="&#xE73E;"/>
          <Setter TargetName="ic" Property="Foreground" Value="#4ADE9B"/>
          <Setter TargetName="badge" Property="Background" Value="#0F2E22"/>
          <Setter TargetName="st" Property="Foreground" Value="#4ADE9B"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Failed">
          <Setter TargetName="ic" Property="Text" Value="&#xE711;"/>
          <Setter TargetName="ic" Property="Foreground" Value="#FF6B7A"/>
          <Setter TargetName="badge" Property="Background" Value="#3A1419"/>
          <Setter TargetName="st" Property="Foreground" Value="#FF6B7A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Skipped">
          <Setter TargetName="ic" Property="Text" Value="&#xE738;"/>
          <Setter TargetName="row" Property="Opacity" Value="0.55"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- tray avatar -->
    <DataTemplate x:Key="TrayItem">
      <Border Width="38" Height="38" CornerRadius="12" Background="#13161D" Padding="3" Margin="-10,0,0,0" ToolTip="{Binding Name}">
        <Viewbox>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LogoTpl}"/>
        </Viewbox>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root" BorderBrush="#1A1D25" BorderThickness="1">
    <Grid ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="272"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ambient glow -->
      <Canvas Grid.Column="1" IsHitTestVisible="False">
        <Ellipse Canvas.Left="380" Canvas.Top="-260" Width="760" Height="480" Opacity="0.55">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#556366F1" Offset="0"/>
              <GradientStop Color="#006366F1" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Canvas.Left="-160" Canvas.Top="-240" Width="620" Height="420" Opacity="0.5">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#44A06BFF" Offset="0"/>
              <GradientStop Color="#00A06BFF" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
      </Canvas>

      <!-- ============ SIDEBAR ============ -->
      <Border Background="#0D0F14" BorderBrush="#171A21" BorderThickness="0,0,1,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="20,18,16,24">
            <StackPanel Orientation="Horizontal">
              <Grid Width="40" Height="40">
                <Border CornerRadius="12" Background="{StaticResource AccentGrad}" Opacity="0.6" Margin="2,6,2,-4">
                  <Border.Effect><BlurEffect Radius="14"/></Border.Effect>
                </Border>
                <Border CornerRadius="12" Background="{StaticResource AccentGrad}">
                  <Grid>
                    <Border CornerRadius="12" Background="{StaticResource Gloss}"/>
                    <TextBlock Text="&#xE943;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </Grid>
              <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="DevSetup" FontSize="17" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource Display}"/>
                  <Border CornerRadius="5" Background="#1E1B3A" Padding="5,0,5,1" Margin="8,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="2.0" FontSize="10" FontWeight="SemiBold" Foreground="#B4A6FF"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="Ambiente dev em minutos" FontSize="11.5" Foreground="#5A6274"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <Border DockPanel.Dock="Bottom" Margin="14,10,14,14" Padding="14,12" CornerRadius="12" Background="#12151B" BorderBrush="#1C2028" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,0,0">
                <Ellipse x:Name="StatusHalo" Fill="#FFB547" Opacity="0.3" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform ScaleX="1.8" ScaleY="1.8"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="StatusDot" Fill="#FFB547"/>
              </Grid>
              <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="StatusTitle" Text="Verificando sistema" FontSize="12.5" FontWeight="SemiBold" Foreground="#D5DAE3"/>
                <TextBlock x:Name="StatusText" Text="Procurando ferramentas já instaladas…" FontSize="11.5" Foreground="#5A6274" TextWrapping="Wrap" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,0,12,8">
              <TextBlock Text="CATEGORIAS" FontSize="10.5" FontWeight="Bold" Foreground="#3F4555" Margin="12,0,0,8"/>
              <ListBox x:Name="CategoryList" ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0">
                <ListBox.Template>
                  <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                </ListBox.Template>
              </ListBox>

              <TextBlock Text="PERFIS RÁPIDOS" FontSize="10.5" FontWeight="Bold" Foreground="#3F4555" Margin="12,24,0,8"/>
              <ItemsControl x:Name="PresetList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource PresetBtn}" ToolTip="Adicionar as ferramentas deste perfil à seleção"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ============ MAIN ============ -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="36"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Grid Grid.Row="1" Margin="40,4,40,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Border CornerRadius="20" Background="#161433" BorderBrush="#2E2766" BorderThickness="1" Padding="10,4,12,5" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#C4B5FD" VerticalAlignment="Center" Margin="0,1,7,0"/>
                <TextBlock Text="Instalação silenciosa e em lote via winget" FontSize="11.5" FontWeight="SemiBold" Foreground="#C4B5FD"/>
              </StackPanel>
            </Border>
            <TextBlock FontSize="32" FontWeight="Bold" FontFamily="{StaticResource Display}" Margin="0,14,0,0">
              <Run Text="Monte seu ambiente " Foreground="White"/><Run Text="em um clique" Foreground="{StaticResource TextGrad}"/>
            </TextBlock>
            <TextBlock Text="Escolha suas ferramentas favoritas — o DevSetup baixa e instala tudo para você." FontSize="14" Foreground="#7F879B" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
              <Border CornerRadius="9" Background="#12151B" BorderBrush="#1C2028" BorderThickness="1" Padding="12,7" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="StatTools" Text="85" FontSize="14" FontWeight="Bold" Foreground="White"/>
                  <TextBlock Text=" ferramentas" FontSize="12.5" Foreground="#7F879B" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                </StackPanel>
              </Border>
              <Border CornerRadius="9" Background="#12151B" BorderBrush="#1C2028" BorderThickness="1" Padding="12,7" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="StatCats" Text="11" FontSize="14" FontWeight="Bold" Foreground="White"/>
                  <TextBlock Text=" categorias" FontSize="12.5" Foreground="#7F879B" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                </StackPanel>
              </Border>
              <Border CornerRadius="9" Background="#0E1F19" BorderBrush="#16382A" BorderThickness="1" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="StatInstalled" Text="–" FontSize="14" FontWeight="Bold" Foreground="#4ADE9B"/>
                  <TextBlock Text=" já instaladas" FontSize="12.5" Foreground="#5FA884" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
          <TextBox x:Name="SearchBox" Grid.Column="1" Width="330" Style="{StaticResource SearchBox}" Tag="Buscar ferramentas, linguagens…" VerticalAlignment="Top" Margin="24,0,0,0"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="40,24,40,6">
          <Border CornerRadius="11" Background="#0F1217" BorderBrush="#1A1D25" BorderThickness="1" Padding="4" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ModeAll" Style="{StaticResource Seg}" IsChecked="True" Content="Todas"/>
              <RadioButton x:Name="ModeSelected" Style="{StaticResource Seg}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Selecionadas"/>
                  <Border x:Name="SelCountPill" CornerRadius="6" Background="#2A2550" Padding="6,0,6,1" Margin="8,0,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="SelCount" Text="0" FontSize="11" Foreground="#C4B5FD"/>
                  </Border>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeMissing" Style="{StaticResource Seg}" Content="Não instaladas"/>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="VisibleCount" Foreground="#3F4555" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="SelectAllBtn" Style="{StaticResource TextBtn}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE762;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Selecionar visíveis"/>
              </StackPanel>
            </Button>
            <Button x:Name="ClearBtn" Style="{StaticResource TextBtn}" Margin="2,0,-10,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE894;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Limpar"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Cards -->
        <ScrollViewer x:Name="CardScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,0,26,0">
          <Grid Margin="0,0,0,120">
            <ItemsControl x:Name="ToolList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <Grid Margin="2,16,14,14">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#E6E8EE" FontFamily="{StaticResource Display}"/>
                        <Border Grid.Column="1" CornerRadius="6" Background="#151820" BorderBrush="#1F232C" BorderThickness="1" Padding="7,0,7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ItemCount}" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B7385"/>
                        </Border>
                        <Rectangle Grid.Column="2" Height="1" Margin="16,1,0,0" VerticalAlignment="Center">
                          <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                              <GradientStop Color="#232833" Offset="0"/>
                              <GradientStop Color="#00232833" Offset="1"/>
                            </LinearGradientBrush>
                          </Rectangle.Fill>
                        </Rectangle>
                      </Grid>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ItemsControl.GroupStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Style="{StaticResource ToolCard}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,80,0,0">
              <Border Width="72" Height="72" CornerRadius="22" Background="#12151B" BorderBrush="#1C2028" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock x:Name="EmptyGlyph" Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="#4A5163" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="EmptyTitle" Text="Nenhuma ferramenta encontrada" FontSize="17" FontWeight="SemiBold" Foreground="#E6E8EE" HorizontalAlignment="Center" Margin="0,18,0,0" FontFamily="{StaticResource Display}"/>
              <TextBlock x:Name="EmptyText" Text="Tente outro termo de busca ou outra categoria." FontSize="13" Foreground="#5A6274" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- fade under tray -->
        <Border Grid.Row="3" Height="130" VerticalAlignment="Bottom" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#000A0B0F" Offset="0"/>
              <GradientStop Color="#F00A0B0F" Offset="0.75"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <!-- Floating tray -->
        <Border Grid.Row="3" VerticalAlignment="Bottom" Margin="40,0,40,22" CornerRadius="18" Background="#13161D" BorderBrush="#232833" BorderThickness="1" Padding="22,14,14,14">
          <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.6" Color="Black"/></Border.Effect>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="TrayEmptyIcon" Width="38" Height="38" Margin="0,0,14,0">
              <Border CornerRadius="12" Background="#1A1E27" BorderBrush="#262B36" BorderThickness="1">
                <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#5A6274" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <StackPanel x:Name="TrayStack" Orientation="Horizontal" Margin="10,0,14,0" Visibility="Collapsed">
              <ItemsControl x:Name="TrayIcons" ItemTemplate="{StaticResource TrayItem}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <Border x:Name="TrayMore" Width="38" Height="38" CornerRadius="12" Background="#13161D" Padding="3" Margin="-10,0,0,0" Visibility="Collapsed">
                <Border CornerRadius="10" Background="#242938">
                  <TextBlock x:Name="TrayMoreText" Text="+3" FontSize="12" FontWeight="Bold" Foreground="#C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="SummaryTitle" Text="Nenhuma ferramenta selecionada" FontSize="15" FontWeight="SemiBold" Foreground="White" FontFamily="{StaticResource Display}"/>
              <TextBlock x:Name="SummaryText" Text="Clique nos cartões ou use um perfil rápido na barra lateral." FontSize="12.5" Foreground="#5A6274" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="CopyBtn" Style="{StaticResource SecondaryBtn}" ToolTip="Copiar os comandos winget da seleção" IsEnabled="False" Padding="15,0">
                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="15"/>
              </Button>
              <Button x:Name="InstallBtn" Style="{StaticResource PrimaryBtn}" Margin="10,0,0,0" IsEnabled="False" MinWidth="210">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock x:Name="InstallBtnText" Text="Instalar"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Toast -->
      <Border x:Name="Toast" Grid.ColumnSpan="2" Panel.ZIndex="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="272,22,0,0"
              CornerRadius="12" Background="#1D212B" BorderBrush="#2E3443" BorderThickness="1" Padding="14,10,18,10" Opacity="0" IsHitTestVisible="False">
        <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black"/></Border.Effect>
        <StackPanel Orientation="Horizontal">
          <Border Width="22" Height="22" CornerRadius="11" Background="#0F2E22" Margin="0,0,10,0">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#4ADE9B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- ============ INSTALL OVERLAY ============ -->
      <Grid x:Name="Overlay" Grid.ColumnSpan="2" Panel.ZIndex="5" Background="#E0060709" Visibility="Collapsed">
        <Border Width="720" Margin="0,60,0,40" CornerRadius="20" Background="#101318" BorderBrush="#232833" BorderThickness="1" Padding="30,28">
          <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.6" Color="Black"/></Border.Effect>
          <DockPanel>
            <Grid DockPanel.Dock="Top">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Width="52" Height="52">
                <Border x:Name="OvGlow" CornerRadius="15" Background="{StaticResource AccentGrad}" Opacity="0.55" Margin="3,8,3,-4">
                  <Border.Effect><BlurEffect Radius="16"/></Border.Effect>
                </Border>
                <Border x:Name="OvIcon" CornerRadius="15" Background="{StaticResource AccentGrad}">
                  <Grid>
                    <Border CornerRadius="15" Background="{StaticResource Gloss}"/>
                    <TextBlock x:Name="OvGlyph" Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="OvTitle" Text="Instalando ferramentas" FontSize="21" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource Display}"/>
                <TextBlock x:Name="OvSub" Text="Alguns instaladores podem pedir permissão de administrador." FontSize="12.5" Foreground="#6B7385" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Top" Margin="0,22,0,16" CornerRadius="12" Background="#0C0E12" BorderBrush="#1A1D25" BorderThickness="1" Padding="16,13">
              <StackPanel>
                <Grid>
                  <TextBlock x:Name="OvCount" Text="0 de 0 concluídas" FontSize="12.5" Foreground="#A3AABA"/>
                  <TextBlock x:Name="OvPercent" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#C4B5FD" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="OvBar" Height="8" Margin="0,10,0,0" Style="{StaticResource SlimBar}"/>
              </StackPanel>
            </Border>

            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
              <Button x:Name="LogToggle" Style="{StaticResource TextBtn}" HorizontalAlignment="Left" Margin="-10,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE756;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock x:Name="LogToggleText" Text="Mostrar log detalhado"/>
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OvCancel" Style="{StaticResource SecondaryBtn}" Content="Cancelar restantes"/>
                <Button x:Name="OvClose" Style="{StaticResource PrimaryBtn}" Content="Concluir" Visibility="Collapsed" MinWidth="140" Margin="10,0,0,0"/>
              </StackPanel>
            </Grid>

            <TextBox x:Name="LogBox" DockPanel.Dock="Bottom" Height="150" Margin="0,12,0,0" Visibility="Collapsed" IsReadOnly="True"
                     Background="#08090C" Foreground="#7F879B" BorderBrush="#1A1D25" BorderThickness="1" Padding="10,8"
                     FontFamily="{StaticResource Mono}" FontSize="11.5" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-10,0" Padding="0,0,10,0">
              <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource QueueItem}"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Window buttons -->
      <StackPanel Grid.ColumnSpan="2" Panel.ZIndex="10" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="MinBtn" Style="{StaticResource ChromeBtn}" Content="&#xE921;"/>
        <Button x:Name="MaxBtn" Style="{StaticResource ChromeBtn}" Content="&#xE922;"/>
        <Button x:Name="CloseBtn" Style="{StaticResource ChromeBtn}" Content="&#xE8BB;" Tag="#E81123"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
