<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="DevSetup" Width="1280" Height="840" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="CardWidth">300</sys:Double>
    <Visibility x:Key="NavTextVisibility">Visible</Visibility>

    <!-- Theme brushes (light defaults; replaced at runtime by DevSetup.ps1) -->
    <SolidColorBrush x:Key="Bg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Sidebar" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavSelected" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="Subtle" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="Border" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Text" Color="#111111"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="TextFaint" Color="#A3A3A3"/>
    <SolidColorBrush x:Key="Accent" Color="#111111"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Success" Color="#15803D"/>
    <SolidColorBrush x:Key="SuccessBg" Color="#ECFDF3"/>
    <SolidColorBrush x:Key="Info" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="InfoBg" Color="#EFF4FF"/>
    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerBg" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="Warning" Color="#B45309"/>
    <SolidColorBrush x:Key="Scrim" Color="#59000000"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A3A3A3"/>
    <SolidColorBrush x:Key="Track" Color="#EDEDED"/>
    <SolidColorBrush x:Key="LogoBg" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="Selection" Color="#BFDBFE"/>

    <!-- ================= Logo (40x40, use Viewbox for other sizes) ================= -->
    <DataTemplate x:Key="LogoTpl">
      <Grid Width="40" Height="40">
        <Border x:Name="tile" CornerRadius="9" Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
          <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border x:Name="iconTile" CornerRadius="9" Background="{DynamicResource LogoBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Visibility="Collapsed">
          <Image Source="{Binding IconPath}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasIcon}" Value="True">
          <Setter TargetName="iconTile" Property="Visibility" Value="Visible"/>
          <Setter TargetName="tile" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding HasIconBg}" Value="True">
          <Setter TargetName="iconTile" Property="Background" Value="{Binding IconBg}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Scrollbar ================= -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="t" CornerRadius="3" Background="{DynamicResource ScrollThumb}" Margin="3,2"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="t" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{DynamicResource Accent}" CornerRadius="6" Padding="9,5">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Buttons ================= -->
    <Style x:Key="ChromeBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Subtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Background="{DynamicResource Accent}">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Subtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Subtle}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
      <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>

    <Style x:Key="TextBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Subtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Search ================= -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="ph" Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
                <Border Grid.Column="2" CornerRadius="4" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="5,1,5,2" VerticalAlignment="Center">
                  <TextBlock Text="Ctrl F" FontSize="10.5" Foreground="{DynamicResource TextFaint}"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Tabs (filter) ================= -->
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="mode"/>
      <Setter Property="Margin" Value="0,0,20,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <ContentPresenter Margin="0,0,0,11" VerticalAlignment="Center"/>
              <Border x:Name="line" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Text}" Visibility="Hidden"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="line" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Sidebar ================= -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ToolTip" Value="{Binding Name}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,7" Margin="0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ic" Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                <TextBlock x:Name="tx" Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextMuted}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="11,0,0,0" Visibility="{DynamicResource NavTextVisibility}"/>
                <TextBlock x:Name="ct" Grid.Column="2" Text="{Binding Count}" Foreground="{DynamicResource TextFaint}" FontSize="12" VerticalAlignment="Center" Visibility="{DynamicResource NavTextVisibility}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Subtle}"/>
                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource NavSelected}"/>
                <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter TargetName="tx" Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="ct" Property="Foreground" Value="{DynamicResource TextMuted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PresetBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTip" Value="{Binding Name}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Padding="10,7" Margin="0,1" Background="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ic" Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                <TextBlock x:Name="n" Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextMuted}" FontSize="13.5" VerticalAlignment="Center" Margin="11,0,0,0" TextTrimming="CharacterEllipsis" Visibility="{DynamicResource NavTextVisibility}"/>
                <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Visibility="{DynamicResource NavTextVisibility}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Subtle}"/>
                <Setter TargetName="n" Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= ComboBox ================= -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" CornerRadius="6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" CornerRadius="4" Padding="9,5" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Subtle}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource ComboToggle}" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter IsHitTestVisible="False" Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Padding="4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Tool card ================= -->
    <Style x:Key="SiteBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="24" Height="22" CornerRadius="5" Background="Transparent">
              <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="11.5" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Subtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolCard" TargetType="ToggleButton">
      <Setter Property="Width" Value="{DynamicResource CardWidth}"/>
      <Setter Property="Height" Value="110"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="card" CornerRadius="10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <Border x:Name="inner" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                <Grid Margin="14,13,10,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LogoTpl}" VerticalAlignment="Top"/>

                  <StackPanel Grid.Column="1" Margin="12,0,8,0">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18" Margin="0,2,0,0"/>
                  </StackPanel>

                  <Grid Grid.Column="2" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,2,0">
                    <Border x:Name="chk" CornerRadius="5" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1.5" Background="{DynamicResource Surface}"/>
                    <TextBlock x:Name="chkMark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentFg}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                  </Grid>

                  <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="52,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                      <Border x:Name="inst" CornerRadius="4" Background="{DynamicResource SuccessBg}" Padding="6,1,6,2" Visibility="Collapsed" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InstalledLabel}" Foreground="{DynamicResource Success}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                      </Border>
                      <Border x:Name="upd" CornerRadius="4" Background="{DynamicResource InfoBg}" Padding="6,1,6,2" Visibility="Collapsed" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateLabel}" Foreground="{DynamicResource Info}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="120" ToolTip="Atualização disponível"/>
                      </Border>
                      <TextBlock x:Name="idText" Text="{Binding Id}" Foreground="{DynamicResource TextFaint}" FontSize="11" VerticalAlignment="Center" FontFamily="{StaticResource Mono}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                    </StackPanel>
                    <Button x:Name="siteBtn" Style="{StaticResource SiteBtn}" Tag="site" HorizontalAlignment="Right" ToolTip="Abrir site oficial" Visibility="Hidden"/>
                  </Grid>
                </Grid>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                <Setter TargetName="chk" Property="BorderBrush" Value="{DynamicResource TextFaint}"/>
                <Setter TargetName="siteBtn" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Text}"/>
                <Setter TargetName="inner" Property="BorderBrush" Value="{DynamicResource Text}"/>
                <Setter TargetName="chk" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="chk" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="chkMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                <Setter TargetName="inst" Property="Visibility" Value="Visible"/>
                <Setter TargetName="idText" Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                <Setter TargetName="upd" Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Progress bar ================= -->
    <Style x:Key="SlimBar" TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource Track}"/>
              <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="pulse">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity" From="0.9" To="0.25" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="pulse"/>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Install queue row ================= -->
    <DataTemplate x:Key="QueueItem">
      <Border x:Name="row" Padding="0,10" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Viewbox Width="30" Height="30">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LogoTpl}"/>
          </Viewbox>
          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="pb" Height="3" Margin="0,7,0,0" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Visibility="Collapsed" Style="{StaticResource SlimBar}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="st" Text="{Binding Status}" Foreground="{DynamicResource TextFaint}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
            <TextBlock x:Name="ic" Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Running">
          <Setter TargetName="ic" Property="Text" Value="&#xE895;"/>
          <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Text}"/>
          <Setter TargetName="st" Property="Foreground" Value="{DynamicResource Text}"/>
          <Setter TargetName="pb" Property="Visibility" Value="Visible"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="spin">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="ic" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="spin"/>
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Done">
          <Setter TargetName="ic" Property="Text" Value="&#xE73E;"/>
          <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Success}"/>
          <Setter TargetName="st" Property="Foreground" Value="{DynamicResource Success}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Failed">
          <Setter TargetName="ic" Property="Text" Value="&#xE711;"/>
          <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Danger}"/>
          <Setter TargetName="st" Property="Foreground" Value="{DynamicResource Danger}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Skipped">
          <Setter TargetName="ic" Property="Text" Value="&#xE738;"/>
          <Setter TargetName="row" Property="Opacity" Value="0.5"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root" BorderBrush="{DynamicResource Border}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarCol" Width="248"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ============ SIDEBAR ============ -->
      <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel x:Name="Brand" DockPanel.Dock="Top" Orientation="Horizontal" Margin="19,14,12,22" Height="26">
            <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource Accent}" VerticalAlignment="Center">
              <TextBlock Text="&#xE756;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource AccentFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="DevSetup" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="10,0,0,1" Visibility="{DynamicResource NavTextVisibility}"/>
          </StackPanel>

          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="14,8,8,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
              <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center" Visibility="{DynamicResource NavTextVisibility}">
                <TextBlock x:Name="StatusText" Text="Verificando conexão…" FontSize="12" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusDetail" Text="" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="ThemeBtn" Grid.Column="2" Style="{StaticResource TextBtn}" Padding="7,5" ToolTip="Alternar tema claro/escuro">
                <TextBlock x:Name="ThemeGlyph" Text="&#xE708;" FontFamily="{StaticResource Icons}" FontSize="13"/>
              </Button>
            </Grid>
          </Border>

          <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,0,10,10">
              <TextBlock Text="Categorias" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" Margin="10,0,0,6" Visibility="{DynamicResource NavTextVisibility}"/>
              <ListBox x:Name="CategoryList" ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0">
                <ListBox.Template>
                  <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                </ListBox.Template>
              </ListBox>

              <TextBlock Text="Perfis" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" Margin="10,22,0,6" Visibility="{DynamicResource NavTextVisibility}"/>
              <Border Height="1" Background="{DynamicResource Border}" Margin="6,14,6,10" x:Name="CompactDivider" Visibility="Collapsed"/>
              <ItemsControl x:Name="PresetList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource PresetBtn}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ============ MAIN ============ -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="40"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banners na barra de título (nova versão do app / sem internet) -->
        <StackPanel Orientation="Horizontal" Margin="16,0,150,0" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Border x:Name="OfflineBanner" CornerRadius="6" Background="{DynamicResource DangerBg}" Padding="10,4" Visibility="Collapsed" Margin="0,0,8,0">
            <TextBlock Text="Sem conexão com a internet: instalar e atualizar estão indisponíveis" FontSize="12" Foreground="{DynamicResource Danger}" TextTrimming="CharacterEllipsis"/>
          </Border>
          <Border x:Name="AppUpdateBanner" CornerRadius="6" Background="{DynamicResource InfoBg}" Padding="10,0,4,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="AppUpdateText" Text="Nova versão do DevSetup disponível" FontSize="12" Foreground="{DynamicResource Info}" VerticalAlignment="Center"/>
              <Button x:Name="AppUpdateBtn" Style="{StaticResource TextBtn}" Padding="8,3" Margin="6,2,0,2">
                <TextBlock Text="Atualizar" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Info}"/>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Header -->
        <Grid x:Name="HeaderGrid" Grid.Row="1" Margin="40,6,40,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Ferramentas" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <TextBlock x:Name="HeaderSub" Text="Instale, atualize ou remova ferramentas de desenvolvimento. Tudo via winget." FontSize="13.5" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBox x:Name="SearchBox" Grid.Column="1" Width="300" Style="{StaticResource SearchBox}" Tag="Buscar" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Grid>

        <!-- Tabs -->
        <Grid x:Name="TabsGrid" Grid.Row="2" Margin="40,20,40,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ModeAll" Style="{StaticResource Tab}" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Todas"/>
                  <TextBlock x:Name="CountAll" Text="0" Foreground="{DynamicResource TextFaint}" FontWeight="Normal" Margin="6,0,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeSelected" Style="{StaticResource Tab}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Selecionadas"/>
                  <TextBlock x:Name="SelCount" Text="0" Foreground="{DynamicResource TextFaint}" FontWeight="Normal" Margin="6,0,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeInstalled" Style="{StaticResource Tab}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Instaladas"/>
                  <TextBlock x:Name="CountInstalled" Text="0" Foreground="{DynamicResource TextFaint}" FontWeight="Normal" Margin="6,0,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeUpdates" Style="{StaticResource Tab}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Atualizações"/>
                  <Border x:Name="UpdatesPill" CornerRadius="8" Background="{DynamicResource Info}" Padding="6,0,6,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="CountUpdates" Text="0" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeMissing" Style="{StaticResource Tab}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Não instaladas"/>
                  <TextBlock x:Name="CountMissing" Text="0" Foreground="{DynamicResource TextFaint}" FontWeight="Normal" Margin="6,0,0,0"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </ScrollViewer>
          <StackPanel x:Name="TabActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,-6,-10,0">
            <Button x:Name="UpdateAllBtn" Style="{StaticResource TextBtn}" Visibility="Collapsed">
              <TextBlock x:Name="UpdateAllText" Text="Atualizar tudo" FontWeight="SemiBold" Foreground="{DynamicResource Info}"/>
            </Button>
            <Button x:Name="SelectAllBtn" Style="{StaticResource TextBtn}" Content="Selecionar visíveis"/>
            <Button x:Name="ClearBtn" Style="{StaticResource TextBtn}" Content="Limpar"/>
          </StackPanel>
        </Grid>

        <!-- Cards -->
        <ScrollViewer x:Name="CardScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,0,28,0">
          <Grid Margin="0,0,0,24">
            <ItemsControl x:Name="ToolList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="0,22,0,12">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="{Binding ItemCount}" FontSize="13" Foreground="{DynamicResource TextFaint}" Margin="8,0,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ItemsControl.GroupStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Style="{StaticResource ToolCard}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,80,0,0">
              <TextBlock x:Name="EmptyGlyph" Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="EmptyTitle" Text="Nenhuma ferramenta encontrada" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
              <TextBlock x:Name="EmptyText" Text="Tente outro termo de busca ou outra categoria." FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- Action bar -->
        <Border x:Name="ActionBar" Grid.Row="4" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="40,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock x:Name="SummaryTitle" Text="Nenhuma ferramenta selecionada" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="SummaryText" Text="Clique nos cartões ou escolha um perfil." FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="CopyBtn" Style="{StaticResource TextBtn}" Content="Copiar comandos" ToolTip="Copiar os comandos winget da seleção" IsEnabled="False" Margin="0,0,6,0"/>
              <Button x:Name="UninstallBtn" Style="{StaticResource DangerBtn}" Visibility="Collapsed" Margin="0,0,8,0">
                <TextBlock x:Name="UninstallBtnText" Text="Desinstalar"/>
              </Button>
              <Button x:Name="UpdateBtn" Style="{StaticResource SecondaryBtn}" Visibility="Collapsed" Margin="0,0,8,0" ToolTip="Atualizar ou trocar a versão das ferramentas instaladas">
                <TextBlock x:Name="UpdateBtnText" Text="Atualizar"/>
              </Button>
              <Button x:Name="InstallBtn" Style="{StaticResource PrimaryBtn}" IsEnabled="False" MinWidth="120">
                <TextBlock x:Name="InstallBtnText" Text="Instalar"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Toast -->
      <Border x:Name="Toast" Grid.ColumnSpan="2" Panel.ZIndex="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,84"
              CornerRadius="8" Background="{DynamicResource Accent}" Padding="14,9" Opacity="0" IsHitTestVisible="False">
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource AccentFg}" FontSize="13"/>
      </Border>

      <!-- ============ REVIEW (instalar / atualizar / desinstalar) ============ -->
      <Grid x:Name="ReviewPanel" Grid.ColumnSpan="2" Panel.ZIndex="6" Background="{DynamicResource Scrim}" Visibility="Collapsed">
        <Border x:Name="ReviewCard" MaxWidth="660" Margin="24,48" VerticalAlignment="Center" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="26,22">
          <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.18" Color="Black"/></Border.Effect>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="ReviewTitle" Text="Revisar instalação" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
              <TextBlock x:Name="ReviewSub" Text="" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button x:Name="ReviewCancel" Style="{StaticResource SecondaryBtn}" Content="Cancelar"/>
              <Button x:Name="ReviewOk" Style="{StaticResource PrimaryBtn}" MinWidth="110" Margin="8,0,0,0">
                <TextBlock x:Name="ReviewOkText" Text="Instalar"/>
              </Button>
            </StackPanel>

            <StackPanel x:Name="DiskSection" DockPanel.Dock="Bottom">
              <TextBlock Text="Disco" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,16,0,8"/>
              <ListBox x:Name="DriveList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Template>
                  <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="b" CornerRadius="8" BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource Surface}" Padding="12,10" Margin="0,0,8,0">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                  <Border x:Name="sys" CornerRadius="4" Background="{DynamicResource Subtle}" Padding="5,0,5,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="Sistema" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                  </Border>
                                </StackPanel>
                                <ProgressBar Height="3" Margin="0,7,0,5" Value="{Binding UsedPercent}" Style="{StaticResource SlimBar}"/>
                                <TextBlock Text="{Binding FreeText}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                              <Grid Grid.Column="1" Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Top">
                                <Ellipse x:Name="radio" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.5" Fill="{DynamicResource Surface}"/>
                                <Ellipse x:Name="dot" Width="6" Height="6" Fill="{DynamicResource AccentFg}" Visibility="Collapsed"/>
                              </Grid>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSystem}" Value="True">
                              <Setter TargetName="sys" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text}"/>
                              <Setter TargetName="radio" Property="Fill" Value="{DynamicResource Accent}"/>
                              <Setter TargetName="radio" Property="Stroke" Value="{DynamicResource Accent}"/>
                              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
              <TextBlock x:Name="DrivePath" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="Nem todo instalador permite escolher o local. Apps da Microsoft Store e alguns instaladores sempre vão para o disco do sistema." FontSize="11.5" Foreground="{DynamicResource TextFaint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- itens -->
            <DockPanel Margin="0,16,0,0">
              <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock x:Name="ReviewListTitle" Text="Versões" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                <TextBlock x:Name="VersionsStatus" FontSize="12" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right"/>
              </Grid>
              <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer x:Name="ReviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="250" Padding="12,0,6,0">
                  <ItemsControl x:Name="ReviewList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="26" Height="26">
                              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LogoTpl}"/>
                            </Viewbox>
                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding ReviewText}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ComboBox x:Name="combo" Grid.Column="2" Width="190" VerticalAlignment="Center"
                                      ItemsSource="{Binding Versions}" SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedVersion, Mode=TwoWay}"
                                      IsEnabled="{Binding VersionsReady}"/>
                          </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding ShowVersionPicker}" Value="False">
                            <Setter TargetName="combo" Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </DockPanel>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ============ PROGRESS OVERLAY ============ -->
      <Grid x:Name="Overlay" Grid.ColumnSpan="2" Panel.ZIndex="5" Background="{DynamicResource Scrim}" Visibility="Collapsed">
        <Border MaxWidth="640" Margin="24,56,24,40" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="26,22">
          <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.18" Color="Black"/></Border.Effect>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="OvGlyph" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,2,10,0" Visibility="Collapsed"/>
                <TextBlock x:Name="OvTitle" Text="Instalando" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
              </StackPanel>
              <TextBlock x:Name="OvSub" Text="" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
              <Grid Margin="0,18,0,0">
                <TextBlock x:Name="OvCount" Text="0 de 0" FontSize="12.5" Foreground="{DynamicResource TextMuted}"/>
                <TextBlock x:Name="OvPercent" Text="0%" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Right"/>
              </Grid>
              <ProgressBar x:Name="OvBar" Height="4" Margin="0,8,0,8" Style="{StaticResource SlimBar}"/>
            </StackPanel>

            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
              <Button x:Name="LogToggle" Style="{StaticResource TextBtn}" HorizontalAlignment="Left" Margin="-10,0,0,0">
                <TextBlock x:Name="LogToggleText" Text="Mostrar log"/>
              </Button>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OvCancel" Style="{StaticResource SecondaryBtn}" Content="Cancelar restantes"/>
                <Button x:Name="OvClose" Style="{StaticResource PrimaryBtn}" Content="Concluir" Visibility="Collapsed" MinWidth="110" Margin="8,0,0,0"/>
              </StackPanel>
            </Grid>

            <TextBox x:Name="LogBox" DockPanel.Dock="Bottom" Height="140" Margin="0,12,0,0" Visibility="Collapsed" IsReadOnly="True"
                     Background="{DynamicResource Subtle}" Foreground="{DynamicResource TextMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10,8"
                     FontFamily="{StaticResource Mono}" FontSize="11.5" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-10,0" Padding="0,0,10,0">
              <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource QueueItem}"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Window buttons -->
      <StackPanel Grid.ColumnSpan="2" Panel.ZIndex="10" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="MinBtn" Style="{StaticResource ChromeBtn}" Content="&#xE921;"/>
        <Button x:Name="MaxBtn" Style="{StaticResource ChromeBtn}" Content="&#xE922;"/>
        <Button x:Name="CloseBtn" Style="{StaticResource CloseBtn}" Content="&#xE8BB;"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
